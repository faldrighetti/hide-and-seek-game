rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function gameDoc(gameId) {
      return get(/databases/$(database)/documents/games/$(gameId));
    }

    function isMember(gameId) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/games/$(gameId)/seats/$(request.auth.uid));
    }

    function isHost(gameId) {
      return isMember(gameId)
        && gameDoc(gameId).data.hostUid == request.auth.uid;
    }

    match /games/{gameId} {
      allow read: if isMember(gameId);
      allow create, update, delete: if false;

      match /seats/{seatUid} {
        allow read: if isMember(gameId);
        allow create, update, delete: if false;
      }

      match /questions/{questionId} {
        allow read: if isMember(gameId);
        allow create, update, delete: if false;
      }

      match /events/{eventId} {
        allow read: if isMember(gameId);
        allow create, update, delete: if false;
      }

      match /notifications/{notificationId} {
        allow read: if isMember(gameId);
        allow create, update, delete: if false;
      }

      match /presence/{uid} {
        allow read: if isMember(gameId);
        allow create, update: if isMember(gameId) && request.auth.uid == uid;
        allow delete: if false;
      }

      match /locations/{uid} {
        allow read: if isMember(gameId);
        allow create, update: if isMember(gameId) && request.auth.uid == uid;
        allow delete: if false;
      }

      match /privateLocations/{uid} {
        allow read, write: if false;
      }

      match /phase/{docId} { allow read: if isMember(gameId); allow write: if false; }
      match /timers/{docId} { allow read: if isMember(gameId); allow write: if false; }
      match /score/{docId} { allow read: if isMember(gameId); allow write: if false; }
      match /scores/{docId} { allow read: if isMember(gameId); allow write: if false; }
      match /deck/{docId} { allow read: if isMember(gameId); allow write: if false; }
      match /cards/{docId} { allow read: if isMember(gameId); allow write: if false; }
      match /dice/{docId} { allow read: if isMember(gameId); allow write: if false; }
      match /penalties/{docId} { allow read: if isMember(gameId); allow write: if false; }
      match /endgame/{docId} { allow read: if isMember(gameId); allow write: if false; }
      match /captain/{docId} { allow read: if isMember(gameId); allow write: if false; }

      match /{sub=**}/{docId} {
        allow read: if false;
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
